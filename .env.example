# Existing AI provider keys
NVIDIA_KEY_GPTOSS=
NVIDIA_KEY_LLAMA=
GEMINI_API_KEY=
MISTRAL_API_KEY=
GROQ_API_KEY=
COHERE_API_KEY=

# Server
PORT=4000

# Free emotion-aware TTS
TTS_PROVIDER=piper
TTS_CACHE_DIR=/tmp/tts-cache
TTS_CACHE_MAX_SIZE=500
TTS_MAX_CHARS=5000
TTS_TIMEOUT_MS=30000

# Piper
PIPER_BIN=piper
PIPER_MODEL=en_US-libritts-high
# PIPER_MODEL_PATH=/absolute/path/to/model.onnx

# XTTS v2 fallback
XTTS_ENABLED=false
XTTS_PYTHON=python
XTTS_MODEL=tts_models/multilingual/multi-dataset/xtts_v2
XTTS_LANGUAGE=en
# XTTS_SPEAKER_WAV=/absolute/path/to/reference.wav
# XTTS_SPEAKER_IDX=p225
